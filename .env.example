APP_NAME="Tenant Ecommerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tenant-ecommerce-api.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Platform and tenancy (spec §6, §7) ------------------------------------
# Root domain: tenants get {slug}.PLATFORM_ROOT_DOMAIN; the root itself and
# CENTRAL_DOMAINS serve the landlord API.
PLATFORM_ROOT_DOMAIN=tenant-ecommerce-api.test
CENTRAL_DOMAINS=localhost,127.0.0.1
TENANCY_DB_PREFIX=tea_tenant_
# Comma-separated Redis connections to prefix per tenant (empty = none).
TENANCY_REDIS_PREFIXED_CONNECTIONS=

# First super-admin, created by InitialPlatformAdminSeeder when no platform
# user exists. It receives a password-set link; no password is seeded.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=

# Origins allowed to call the landlord admin API (comma-separated).
PLATFORM_ADMIN_ORIGINS=http://localhost:3000

# Frontend link targets used in emails (password set/reset, verification).
PLATFORM_ADMIN_URL=http://localhost:3000
AFFILIATE_PORTAL_URL=http://localhost:3001
PLATFORM_WEBSITE_URL=http://localhost:3002
TENANT_FRONTEND_SCHEME=https
TENANT_ADMIN_PATH=/admin

# Live payment credentials and live mode are refused unless true (§15.9).
PAYMENTS_LIVE_ALLOWED=false

# Edge (TLS on-demand / custom domain) callers of landlord.internal routes.
EDGE_ALLOWED_IPS=
EDGE_SHARED_SECRET=

# --- Databases (spec §6.6) ---------------------------------------------------
DB_CONNECTION=landlord
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tea_landlord
DB_USERNAME=root
DB_PASSWORD=

# Template for tenant connections; each falls back to the DB_* value.
# Per-server credentials live in the database_servers table.
TENANT_DB_HOST=
TENANT_DB_PORT=
TENANT_DB_USERNAME=
TENANT_DB_PASSWORD=

# --- Auth (spec §10) ----------------------------------------------------------
# Token lifetime in minutes (default 30 days).
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=tea_

# --- Cache, queue, sessions (spec §72, §74) -----------------------------------
# Production: redis for both stores and the queue, with Horizon.
CACHE_STORE=database
LANDLORD_CACHE_STORE=
# CACHE_PREFIX=
QUEUE_CONNECTION=database
SESSION_DRIVER=array

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REVERB_APP_ID=761371
REVERB_APP_KEY=9veq0lanofkuut1xrfkm
REVERB_APP_SECRET=lhmms187m3cj06eawt4g
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Mail (spec §16.2): the platform mailer --------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS (spec §16.3): the platform gateway (termii | africas_talking) --------
PLATFORM_SMS_PROVIDER=
SMS_HTTP_TIMEOUT=10
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=
AFRICASTALKING_BASE_URL=https://api.africastalking.com
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- WhatsApp (spec §16.4): the platform number (Meta Cloud API) -----------------
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_HTTP_TIMEOUT=10

# --- Push (spec §16.5): Firebase Cloud Messaging service account ---------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# PEM key on one line with literal \n separators.
FCM_PRIVATE_KEY=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
FCM_BASE_URL=https://fcm.googleapis.com
FCM_HTTP_TIMEOUT=10

# --- Multi-currency (spec §48): reference-rate provider (UD-19) -------------------
# none: staff set rates by hand (default). open_er_api: open.er-api.com, free, no
# key, refreshed daily per store; manual rates are never overwritten.
FX_PROVIDER=none
FX_OPEN_ER_API_URL=https://open.er-api.com/v6
FX_HTTP_TIMEOUT=10

# --- Point of sale (spec §51): card-terminal endpoints ------------------------------
# Credentials are entered per register in the store admin (encrypted), never here.
# Terminals take real money only: card_terminal is refused while a store is in test mode.
POS_MONIEPOINT_BASE_URL=https://channel.moniepoint.com
POS_OPAY_BASE_URL=https://liveapi.opaycheckout.com
POS_OPAY_COUNTRY=NG
# An offline sale synced later may carry its own sale time, up to this age.
POS_OFFLINE_SALE_MAX_AGE_HOURS=72

# --- Storage (spec §6.3): media disks media-public and media-private ----------------
# The platform provides storage; each store gets a tenants/{id}/ prefix.
# local: folders under storage/app (run `php artisan storage:link` once).
# s3:    any S3-compatible service (AWS S3, Cloudflare R2, DigitalOcean Spaces,
#        Backblaze B2, MinIO). One bucket works: expose only public/* by policy/CDN.
MEDIA_DRIVER=local
# Optional overrides of the local folders (relative to the project, or absolute).
MEDIA_PUBLIC_ROOT=
MEDIA_PRIVATE_ROOT=
# Public base URL of media-public: a CDN or the bucket's public URL (s3), or
# leave empty for APP_URL/storage/media (local).
MEDIA_PUBLIC_URL=
# Separate buckets are optional; both default to AWS_BUCKET.
MEDIA_PUBLIC_BUCKET=
MEDIA_PRIVATE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2: auto. AWS: the bucket's region, e.g. eu-west-2.
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# Required for non-AWS services, e.g. https://{account-id}.r2.cloudflarestorage.com
AWS_ENDPOINT=
# true for MinIO; false for AWS S3 and R2.
AWS_USE_PATH_STYLE_ENDPOINT=false
# Only for the framework's plain `s3` disk; the media disks use MEDIA_PUBLIC_URL.
AWS_URL=

# --- Store integrations (spec §68, §69) ----------------------------------------------
# Tenants enter their own WooCommerce keys and channel tokens in the admin.
# TikTok Shop signs every request with the platform's app key and secret
# (from the TikTok Shop partner centre); leave empty to leave TikTok Shop off.
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Only for local development against a store on a private address.
INTEGRATIONS_ALLOW_PRIVATE_HOSTS=false
# Optional overrides:
# META_GRAPH_URL=https://graph.facebook.com/v21.0
# TIKTOK_SHOP_API_URL=https://open-api.tiktokglobalshop.com

# --- Auditing and activity (spec §19) -----------------------------------------------
AUDITING_ENABLED=true
ACTIVITYLOG_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Optional (the defaults shown apply when unset) ---------------------------------
# API docs (dedoc/scramble): on while APP_DEBUG is true.
# SCRAMBLE_DEV_TOOLS=false
# API_VERSION=0.0.1
# Media image driver: gd or imagick.
# IMAGE_DRIVER=gd
# World data (nnjeim/world): IP geolocation needs a MaxMind key.
# WORLD_CACHE_ENABLED=true
# MAXMIND_LICENSE_KEY=
